---
import { slugForJob } from "../lib/jobs";

interface Props {
  slug: string;
}

const { slug } = Astro.props;

let data: {
  updatedAt: string | null;
  bySlug: Record<string, JobRow[]>;
} | null = null;

interface JobRow {
  slug?: string;
  title: string;
  employer: string;
  location: string;
  type?: string;
  pay?: string;
  posted?: string;
  source?: string;
  url: string;
  logo?: string;
  description?: string[];
}

try {
  const mod = await import("../data/jobs.json");
  data = mod.default;
} catch {
  data = null;
}

const rows = data?.bySlug?.[slug] ?? [];
const shown = rows.slice(0, 24);

const initials = (name: string) =>
  (name || "?")
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w.charAt(0).toUpperCase())
    .join("");
---

<section class="card">
  <div class="section-head">
    <h2>Live Phlebotomist Job Openings</h2>
    {
      data?.updatedAt && (
        <span class="kicker mono">Updated {data.updatedAt}</span>
      )
    }
  </div>

  {
    rows.length > 0 ? (
      <>
        <div class="jobs">
          {
            shown.map((job) => (
              <article class="job">
                <div class="job-logo">
                  <span class="logo-fallback">{initials(job.employer)}</span>
                  {
                    job.logo && (
                      <img
                        class="logo-img"
                        src={job.logo}
                        alt={job.employer}
                        loading="lazy"
                        referrerpolicy="no-referrer"
                        onerror="this.remove()"
                      />
                    )
                  }
                </div>
                <div class="job-main">
                  <a class="job-title" href={`/jobs/${slugForJob(job)}`}>
                    {job.title}
                  </a>
                  <div class="job-meta">
                    {job.employer && <p class="job-org">{job.employer}</p>}
                    {job.pay && <p class="job-salary">{job.pay}</p>}
                    {job.location && <p class="job-location">{job.location}</p>}
                  </div>
                  {
                    job.type && (
                      <div class="job-chips">
                        <span class="job-chip">{job.type}</span>
                      </div>
                    )
                  }
                </div>
                <div class="job-side">
                  <a class="job-apply" href={`/jobs/${slugForJob(job)}`}>
                    Apply
                  </a>
                  {job.posted && <span class="job-posted">{job.posted}</span>}
                </div>
              </article>
            ))
          }
        </div>
        {rows.length > shown.length && (
          <p class="copy-note">
            Showing {shown.length} of {rows.length} recent phlebotomist job listings.
          </p>
        )}
      </>
    ) : (
      <p class="muted">
        Live openings for this page update daily. Check back soon for current
        phlebotomist job listings in this area.
      </p>
    )
  }
</section>

<style>
  .jobs {
    display: grid;
    gap: 12px;
  }

  .job {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    align-items: flex-start;
    background: var(--white);
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 20px 24px 16px;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .job-logo {
    position: relative;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 10px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
  }

  .logo-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: #64748b;
    border-radius: 10px;
  }

  .logo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--white);
    border-radius: 10px;
    padding: 5px;
  }

  .job:hover {
    background: #f9fcff;
    border-color: #cbd5e1;
  }

  .job-main {
    flex: 1;
    min-width: 0;
  }

  .job-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .job-title:hover {
    color: var(--accent-dark);
    text-decoration: none;
  }

  .job-meta {
    margin-top: 6px;
    margin-bottom: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .job-org {
    margin: 0;
    color: #0f172a;
    font-size: 14px;
    line-height: 1.25;
    font-weight: 600;
  }

  .job-salary {
    margin: 0;
    color: #334155;
    font-size: 13px;
    line-height: 1.25;
    font-weight: 600;
  }

  .job-location {
    margin: 0;
    color: #475569;
    font-size: 14px;
    line-height: 1.25;
  }

  .job-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  .job-chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border: 1px solid #e2e8f0;
    border-radius: 2px;
    background: var(--white);
    font-size: 13px;
    line-height: 1.2;
    color: #0f172a;
    white-space: nowrap;
  }

  .job-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    flex-shrink: 0;
  }

  .job-posted {
    color: #475569;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
  }

  .job-apply {
    display: inline-block;
    background: var(--ink);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 9px 28px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s ease, opacity 0.15s ease, transform 0.15s ease;
    opacity: 0;
    transform: translateY(3px);
    pointer-events: none;
  }

  .job:hover .job-apply,
  .job:focus-within .job-apply {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .job-apply:hover {
    background: var(--ink-2);
    text-decoration: none;
  }

  @media (hover: none) {
    .job-apply {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  @media (max-width: 640px) {
    .job {
      flex-wrap: wrap;
    }

    .job-side {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
  }
</style>
